# Скопируйте в .env и заполните своими значениями.
# .env в git не коммитится (см. .gitignore в корне).

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_GEN_MODEL=gemini-2.0-flash
# true = моки вместо реальных эмбеддингов и LLM-вызовов. На проде обязательно false.
IMITATION_MODE=false

# --- Векторная база (Pinecone) ---
PINECONE_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# --- WhatsApp Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=
WABA_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=          # произвольная строка, её же вбить в настройках вебхука Meta
WA_API_VERSION=v21.0
WA_USE_TEMPLATES=false    # true = слать lifecycle через approved-шаблоны
ADMIN_WA=                 # номер для админ-уведомлений, пусто = только лог
WA_TEST_TO=               # ваш номер для тестовых прогонов

# --- URLs ---
APP_URL=http://localhost:8001
WEB_URL=http://localhost:3000

# --- Голосовые звонки (Vapi) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=        # пусто = inline-конфиг из voice_agent.py
VAPI_BASE_URL=https://api.vapi.ai

# --- Режимы ---
FREE_MODE=true            # без квот и оплаты, все ивенты бесплатные
